<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BG3HonourRecovery</AssemblyName>
    <RootNamespace>Bg3HonourRecovery</RootNamespace>
    <Version>1.0.0</Version>
    <Product>BG3 荣誉模式存档恢复器</Product>
    <Description>恢复 profile8.lsf 中被标记为自定义模式的 BG3 荣誉战役</Description>
    <Authors>Sitch</Authors>
    <Copyright>Copyright © 2026</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.IO.Hashing" Version="9.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="LSLib">
      <HintPath>..\ThirdParty\LSLib\LSLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="K4os.Compression.LZ4">
      <HintPath>..\ThirdParty\LSLib\K4os.Compression.LZ4.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="K4os.Compression.LZ4.Streams">
      <HintPath>..\ThirdParty\LSLib\K4os.Compression.LZ4.Streams.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="K4os.Hash.xxHash">
      <HintPath>..\ThirdParty\LSLib\K4os.Hash.xxHash.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\ThirdParty\LSLib\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Mathematics">
      <HintPath>..\ThirdParty\LSLib\OpenTK.Mathematics.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SharpGLTF.Core">
      <HintPath>..\ThirdParty\LSLib\SharpGLTF.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SharpGLTF.Runtime">
      <HintPath>..\ThirdParty\LSLib\SharpGLTF.Runtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SharpGLTF.Toolkit">
      <HintPath>..\ThirdParty\LSLib\SharpGLTF.Toolkit.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ZstdSharp">
      <HintPath>..\ThirdParty\LSLib\ZstdSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
